# Turhost FTP kimlik bilgileri — scripts/upload-*.py, scripts/enable-router.py,
# scripts/deploy-ftp.py bu üç değişkeni okur. Hiçbirinin kod içinde varsayılan
# (fallback) değeri yoktur; biri eksikse script açık bir hata ile çıkar.
#
# Kullanım: bu dosyayı `.env` olarak kopyalayıp gerçek değerleri girin, sonra
# ortamınıza yükleyin (örn. `set -a && source .env && set +a`) ve scripti
# çalıştırın. `.env` asla commit edilmez (.gitignore'da).
FTP_HOST=ftp.medidentistanbul.com
FTP_USER=medident
FTP_PASS=
